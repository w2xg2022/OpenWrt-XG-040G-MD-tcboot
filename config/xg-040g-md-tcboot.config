#
# Target：Nokia Bell XG-040G-MD（与上游 xiangtailiang 同机型，经 Web U-Boot 刷入），
#         openwrt-25.12 分支，内核 6.12
# 产物：openwrt-airoha-an7581-bell_xg-040g-md-squashfs-factory.bin
#
CONFIG_TARGET_airoha=y
CONFIG_TARGET_airoha_an7581=y
CONFIG_TARGET_airoha_an7581_DEVICE_bell_xg-040g-md=y
CONFIG_ARCH_64BIT=y
CONFIG_aarch64=y
CONFIG_LINUX_6_12=y

#
# Airoha 硬件
#
CONFIG_PACKAGE_airoha-en7581-npu-firmware=y
CONFIG_PACKAGE_kmod-phy-airoha-en8811h=y
CONFIG_PACKAGE_kmod-i2c-an7581=y

#
# 基础系统
#
CONFIG_PACKAGE_uboot-envtools=y
CONFIG_PACKAGE_kmod-ubootenv-nvram=y
CONFIG_PACKAGE_uclient-fetch=y
CONFIG_PACKAGE_kmod-gpio-button-hotplug=y
CONFIG_PACKAGE_kmod-leds-gpio=y
CONFIG_PACKAGE_ubi-utils=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-mtd-rw=y
CONFIG_PACKAGE_fwtool=y

#
# 网络
#
CONFIG_PACKAGE_dnsmasq=y
CONFIG_PACKAGE_ip-full=y
CONFIG_IPV6=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-nf-flow=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_ethtool-full=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_umdns=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y

#
# 包管理器 apk
#
CONFIG_PACKAGE_apk-mbedtls=y

#
# SSH
#
CONFIG_PACKAGE_dropbear=y
CONFIG_DROPBEAR_ED25519=y
CONFIG_DROPBEAR_CURVE25519=y

#
# LuCI：默认 Bootstrap 主题、简体中文
#
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
# CONFIG_PACKAGE_luci-theme-argon is not set
# CONFIG_PACKAGE_luci-app-argon-config is not set
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y

#
# turboacc（流量分载 + 全锥形 NAT + BBR）
#
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_OFFLOADING=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_NFT_FULLCONE=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_BBR_CCA=y
CONFIG_PACKAGE_luci-i18n-turboacc-zh-cn=y

#
# 定时重启（ImmortalWrt 简单版）
#
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-i18n-autoreboot-zh-cn=y

#
# LED（LuCI「系统 → LED 配置」+ 更多触发器）
#
CONFIG_PACKAGE_kmod-ledtrig-activity=y
CONFIG_PACKAGE_kmod-ledtrig-oneshot=y
CONFIG_PACKAGE_kmod-ledtrig-pattern=y
CONFIG_PACKAGE_kmod-ledtrig-transient=y
CONFIG_PACKAGE_kmod-usb-ledtrig-usbport=y

#
# 网口 LAN/WAN 设置工具
#
# CONFIG_PACKAGE_luci-app-portconfig is not set
# CONFIG_PACKAGE_luci-i18n-portconfig-zh-cn is not set

#
# 不带 HomeProxy / PassWall
#
# CONFIG_PACKAGE_luci-app-homeproxy is not set
# CONFIG_PACKAGE_luci-app-passwall is not set

#
# USB 存储：硬盘 / U 盘（NTFS / exFAT / FAT32 / ext4 / HFS+ / Btrfs）
#
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-xhci-hcd=y
CONFIG_PACKAGE_kmod-usb-xhci-mtk=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_kmod-scsi-core=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-hfsplus=y
CONFIG_PACKAGE_kmod-fs-btrfs=y
CONFIG_PACKAGE_kmod-nls-utf8=y
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_kmod-nls-cp936=y
CONFIG_PACKAGE_kmod-nls-cp950=y
CONFIG_PACKAGE_kmod-nls-iso8859-1=y
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_ntfs-3g-utils=y
CONFIG_PACKAGE_exfat-fsck=y
CONFIG_PACKAGE_dosfstools=y
CONFIG_PACKAGE_usbutils=y

#
# USB 无线网卡
#
CONFIG_PACKAGE_wpad-basic-mbedtls=y
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_wireless-regdb=y
# RTL8822BU / RTL8821CU（rtw88）
CONFIG_PACKAGE_kmod-rtw88-8822bu=y
CONFIG_PACKAGE_kmod-rtw88-8821cu=y
# MT7612U（mt76x2u）
CONFIG_PACKAGE_kmod-mt76x2u=y
# AIC8800D80（自 ImmortalWrt 移植）+ 驱动光盘模式自动切换
CONFIG_PACKAGE_kmod-aic8800-usb=y
CONFIG_PACKAGE_aic8800-usb-firmware=y
CONFIG_PACKAGE_usb-modeswitch=y

#
# USB 有线网卡：RTL8156B 2.5G（r8152 驱动）
#
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y

#
# 编译选项
#
CONFIG_DEVEL=y
CONFIG_CCACHE=y
# 额外产出 ImageBuilder，之后改设定/增减现成包不用重编
CONFIG_IB=y
