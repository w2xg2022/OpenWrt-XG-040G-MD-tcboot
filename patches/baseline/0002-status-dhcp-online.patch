+	/* 加法排查：在线状态，解析 ip neigh 的 JSON 输出，按 MAC 汇总 ARP/NDP 状态 */
+	buildOnlineMap(neigh4, neigh6) {
+		const onlineStates = [ 'REACHABLE', 'STALE', 'DELAY', 'PROBE', 'PERMANENT', 'NOARP' ];
+		const map = {};
+
+		const parse = (res) => {
+			if (!res || res.code !== 0 || !res.stdout)
+				return;
+
+			let entries;
+			try { entries = JSON.parse(res.stdout); } catch (e) { return; }
+
+			if (!Array.isArray(entries))
+				return;
+
+			for (const e of entries) {
+				if (!e.lladdr)
+					continue;
+
+				const mac = e.lladdr.toLowerCase();
+				const states = L.toArray(e.state);
+				const isOnline = states.some((st) => onlineStates.indexOf(st) !== -1);
+
+				if (isOnline || !map.hasOwnProperty(mac))
+					map[mac] = isOnline;
+			}
+		};
+
+		parse(neigh4);
+		parse(neigh6);
+
+		return map;
+	},
+
+	render(data) {
+		const [ dhcp_leases, host_hints, ufp_list ] = data;
+
+		if (L.hasSystemFeature('dnsmasq') || L.hasSystemFeature('odhcpd')) {
+			const onlineMap = this.buildOnlineMap(data[4], data[5]);
+			return this.renderLeases(dhcp_leases, host_hints, ufp_list, onlineMap);
+		}
 
 		return null;
 	},
